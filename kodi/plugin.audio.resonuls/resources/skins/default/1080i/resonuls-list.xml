<?xml version="1.0" encoding="UTF-8"?>
<!-- One of the add-on's lists in the app: an album, a playlist, a search. -->
<window>
  <defaultcontrol always="true">100</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="FF0F1115">resonuls-white.png</texture>
    </control>
    <control type="label">
      <left>80</left><top>36</top><width>440</width><height>70</height>
      <font>font30_title</font><textcolor>FF1DB954</textcolor>
      <label>$INFO[Window.Property(title)]</label>
    </control>
    <control type="label">
      <left>1120</left><top>36</top><width>500</width><height>70</height>
      <font>font45_title</font><textcolor>FFFFFFFF</textcolor><align>right</align>
      <label>$INFO[System.Time]</label>
      <visible>!Player.HasAudio</visible>
    </control>
    <!-- Closes the app, for a remote whose back key does not. -->
    <control type="button" id="510">
      <left>1650</left><top>28</top><width>190</width><height>64</height>
      <texturefocus colordiffuse="FF1DB954">resonuls-tile.png</texturefocus>
      <texturenofocus colordiffuse="FF2A2F36">resonuls-tile.png</texturenofocus>
      <label>$ADDON[plugin.audio.resonuls 30076]</label>
      <font>font13</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
      <align>center</align><aligny>center</aligny><textoffsetx>0</textoffsetx>
      <onleft>504</onleft><ondown>100</ondown>
    </control>
    <!-- What plays, with pause, stop, next and Kodi's player: up from the
         first row or the list. -->
    <control type="group">
      <visible>Player.HasAudio</visible>
      <control type="image">
        <left>520</left><top>28</top><width>64</width><height>64</height>
        <texture diffuse="resonuls-tile.png" background="true">$INFO[MusicPlayer.Cover]</texture>
        <aspectratio>scale</aspectratio>
      </control>
      <control type="label">
        <left>600</left><top>26</top><width>720</width><height>36</height>
        <font>font13</font><textcolor>FFFFFFFF</textcolor>
        <label>$INFO[MusicPlayer.Title]</label>
      </control>
      <control type="label">
        <left>600</left><top>62</top><width>720</width><height>30</height>
        <font>font12</font><textcolor>FF9AA0A6</textcolor>
        <label>$INFO[MusicPlayer.Artist,, · ]$INFO[MusicPlayer.Time]$INFO[MusicPlayer.Duration, / ]</label>
      </control>
      <control type="button" id="501">
        <left>1350</left><top>28</top><width>64</width><height>64</height>
        <texturefocus colordiffuse="FF1DB954">resonuls-tile.png</texturefocus>
        <texturenofocus colordiffuse="FF2A2F36">resonuls-tile.png</texturenofocus>
        <label></label>
        <onleft>501</onleft><onright>502</onright><ondown>100</ondown>
        <onclick>PlayerControl(Play)</onclick>
      </control>
      <control type="image">
        <left>1350</left><top>28</top><width>64</width><height>64</height>
        <texture>resonuls-play.png</texture>
        <visible>Player.Paused</visible>
      </control>
      <control type="image">
        <left>1350</left><top>28</top><width>64</width><height>64</height>
        <texture>resonuls-pause.png</texture>
        <visible>!Player.Paused</visible>
      </control>
      <control type="button" id="502">
        <left>1422</left><top>28</top><width>64</width><height>64</height>
        <texturefocus colordiffuse="FF1DB954">resonuls-tile.png</texturefocus>
        <texturenofocus colordiffuse="FF2A2F36">resonuls-tile.png</texturenofocus>
        <label></label>
        <onleft>501</onleft><onright>503</onright><ondown>100</ondown>
        <onclick>PlayerControl(Stop)</onclick>
      </control>
      <control type="image">
        <left>1422</left><top>28</top><width>64</width><height>64</height>
        <texture>resonuls-stop.png</texture>
      </control>
      <control type="button" id="503">
        <left>1494</left><top>28</top><width>64</width><height>64</height>
        <texturefocus colordiffuse="FF1DB954">resonuls-tile.png</texturefocus>
        <texturenofocus colordiffuse="FF2A2F36">resonuls-tile.png</texturenofocus>
        <label></label>
        <onleft>502</onleft><onright>504</onright><ondown>100</ondown>
        <onclick>PlayerControl(Next)</onclick>
      </control>
      <control type="image">
        <left>1494</left><top>28</top><width>64</width><height>64</height>
        <texture>resonuls-next.png</texture>
      </control>
      <control type="button" id="504">
        <left>1566</left><top>28</top><width>64</width><height>64</height>
        <texturefocus colordiffuse="FF1DB954">resonuls-tile.png</texturefocus>
        <texturenofocus colordiffuse="FF2A2F36">resonuls-tile.png</texturenofocus>
        <label></label>
        <onleft>503</onleft><onright>510</onright><ondown>100</ondown>
        <onclick>ActivateWindow(visualisation)</onclick>
      </control>
      <control type="image">
        <left>1566</left><top>28</top><width>64</width><height>64</height>
        <texture>resonuls-expand.png</texture>
      </control>
    </control>
    <control type="label">
      <left>0</left><top>500</top><width>1920</width><height>60</height>
      <font>font30_title</font><textcolor>FF9AA0A6</textcolor><align>center</align>
      <label>$ADDON[plugin.audio.resonuls 30071]</label>
      <visible>String.IsEqual(Window.Property(loading),true)</visible>
    </control>
    <control type="label">
      <left>0</left><top>500</top><width>1920</width><height>60</height>
      <font>font30_title</font><textcolor>FF9AA0A6</textcolor><align>center</align>
      <label>$ADDON[plugin.audio.resonuls 30058]</label>
      <visible>String.IsEqual(Window.Property(empty),true)</visible>
    </control>
    <control type="list" id="100">
      <left>66</left><top>130</top><width>1788</width><height>900</height>
      <onup condition="Player.HasAudio">501</onup>
          <onup condition="!Player.HasAudio">510</onup>
      <orientation>vertical</orientation>
      <scrolltime tween="cubic" easing="out">200</scrolltime>
      <itemlayout height="100" width="1788">
          <control type="image">
            <left>14</left><top>8</top><width>84</width><height>84</height>
            <texture colordiffuse="FF1E2228">resonuls-tile.png</texture>
          </control>
          <control type="image">
            <left>14</left><top>8</top><width>84</width><height>84</height>
            <texture diffuse="resonuls-tile.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
            <aspectratio>scale</aspectratio>
          </control>
          <control type="label">
            <left>124</left><top>12</top><width>1580</width><height>40</height>
            <font>font13</font><textcolor>FFE0E0E0</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <scroll>false</scroll>
          </control>
          <control type="label">
            <left>124</left><top>54</top><width>1580</width><height>34</height>
            <font>font12</font><textcolor>FF9AA0A6</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
      </itemlayout>
      <focusedlayout height="100" width="1788">
          <control type="image">
            <left>0</left><top>0</top><width>1788</width><height>100</height>
            <texture colordiffuse="331DB954">resonuls-white.png</texture>
            <visible>Control.HasFocus(100)</visible>
          </control>
          <control type="image">
            <left>14</left><top>8</top><width>84</width><height>84</height>
            <texture colordiffuse="FF1E2228">resonuls-tile.png</texture>
          </control>
          <control type="image">
            <left>14</left><top>8</top><width>84</width><height>84</height>
            <texture diffuse="resonuls-tile.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
            <aspectratio>scale</aspectratio>
          </control>
          <control type="label">
            <left>124</left><top>12</top><width>1580</width><height>40</height>
            <font>font13</font><textcolor>FFFFFFFF</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <scroll>true</scroll>
          </control>
          <control type="label">
            <left>124</left><top>54</top><width>1580</width><height>34</height>
            <font>font12</font><textcolor>FF9AA0A6</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
      </focusedlayout>
    </control>
  </controls>
</window>

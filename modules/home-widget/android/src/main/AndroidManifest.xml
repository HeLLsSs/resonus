<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- The home-screen "Now playing" widget. Exported because the launcher is
         what sends APPWIDGET_UPDATE; the button broadcasts are explicit intents built
         by the app itself, and nothing they can ask for goes beyond what a
         media key can (see HomeWidgetProvider). -->
    <receiver
      android:name="expo.modules.homewidget.HomeWidgetProvider"
      android:exported="true"
      android:label="@string/widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/home_widget_info" />
    </receiver>
  </application>
</manifest>

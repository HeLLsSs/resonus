<?xml version="1.0" encoding="utf-8"?>
<!-- The tall widget (4x3 and up): the wide one's head, and under it a row
     for each of the next songs of the queue that fits, a tap on one skipping
     to it. HomeWidgetRenderer hides the rows there is no song or room for,
     and the whole block when there is none, which leaves the head centred. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp"
    android:theme="@style/HomeWidgetTheme">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:contentDescription="@string/widget_open_player"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_artwork" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

      <TextView
          android:id="@+id/widget_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="@string/widget_nothing_playing"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="15sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/widget_artist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="@string/widget_open_app"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="13sp" />

      <LinearLayout
          android:id="@+id/widget_controls"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_previous"
            android:scaleType="center"
            android:src="@drawable/ic_widget_prev"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/home_widget_play_bg"
            android:contentDescription="@string/widget_play"
            android:scaleType="center"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_on_accent" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_next"
            android:scaleType="center"
            android:src="@drawable/ic_widget_next"
            android:tint="?android:attr/textColorPrimary" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:id="@+id/widget_queue"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_up1"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

      <TextView
          android:id="@+id/widget_up1_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="13sp" />

      <TextView
          android:id="@+id/widget_up1_artist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:maxWidth="120dp"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_up2"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

      <TextView
          android:id="@+id/widget_up2_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="13sp" />

      <TextView
          android:id="@+id/widget_up2_artist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:maxWidth="120dp"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_up3"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

      <TextView
          android:id="@+id/widget_up3_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="13sp" />

      <TextView
          android:id="@+id/widget_up3_artist"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:maxWidth="120dp"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>

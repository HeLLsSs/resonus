<?xml version="1.0" encoding="utf-8"?>
<!-- The square widget (2x2): the cover is the whole of it, with the title
     and the play/pause button laid over its foot. With nothing playing the
     cover gives way to the app's icon, put in from HomeWidgetRenderer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_bg"
    android:theme="@style/HomeWidgetTheme">

  <ImageView
      android:id="@+id/widget_artwork"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@string/widget_open_player"
      android:scaleType="centerCrop"
      android:src="@drawable/ic_widget_artwork" />

  <ImageView
      android:id="@+id/widget_app_icon"
      android:layout_width="72dp"
      android:layout_height="72dp"
      android:layout_gravity="center"
      android:layout_marginBottom="16dp"
      android:contentDescription="@string/widget_open_app"
      android:visibility="gone" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:background="@drawable/home_widget_scrim"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingTop="20dp"
      android:paddingEnd="8dp"
      android:paddingBottom="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_nothing_playing"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/home_widget_overlay_bg"
        android:contentDescription="@string/widget_play"
        android:scaleType="center"
        android:src="@drawable/ic_widget_play"
        android:tint="#FFFFFFFF" />
  </LinearLayout>
</FrameLayout>
